{
  "appId": "com.zhangl.examtutor",
  "appName": "公考辅导",
  "webDir": "web/dist",
  "backgroundColor": "#F5F6FA",
  "ios": {
    "scheme": "ExamTutor",
    "allowsLinkPreview": false,
    "contentInset": "never"
  },
  "plugins": {
    "CapacitorSQLite": {
      "iosDatabaseLocation": "Library/CapacitorDatabase",
      "iosIsEncryption": true,
      "iosKeychainPrefix": "com.zhangl.examtutor.sqlite"
    },
    "StatusBar": {
      "style": "light",
      "overlaysWebView": true,
      "backgroundColor": "#F5F6FA"
    }
  }
}
