{
  "name": "zhangl-agent",
  "version": "1.3.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "web:build": "cd web && npm run build",
    "ios:sync": "npm run web:build && bash scripts/sync-vue-ios-public.sh",
    "ios:sync:web": "npm run ios:sync",
    "ios:archive": "npm run ios:sync && bash scripts/archive-ios-web.sh",
    "ios:archive:web": "npm run ios:archive",
    "ios:verify-ipa": "node scripts/verify-ios-ipa.js",
    "release:assets": "bash scripts/build-release-assets.sh",
    "smoke:ios": "npm run smoke:vue",
    "check:design": "node scripts/check-design-system.js",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:database-schema": "bash scripts/verify-tutor-database.sh",
    "check:data-maintenance": "node scripts/verify-data-maintenance.mjs",
    "check:metadata": "node scripts/verify-curriculum-fixtures.mjs",
    "check:onboarding": "node scripts/verify-candidate-onboarding.mjs",
    "check:content-schema": "node scripts/verify-content-schema.mjs",
    "check:content-metadata": "node scripts/verify-content-metadata.mjs",
    "check:prompt-compiler": "node scripts/verify-prompt-compiler.mjs",
    "check:provider-gateway": "node scripts/verify-provider-gateway.mjs",
    "check:web-research": "node scripts/verify-web-research.mjs",
    "check:generation-workflow": "node scripts/verify-generation-workflow.mjs",
    "check:generation-diversity": "node scripts/verify-generation-diversity.mjs",
    "check:generation-foundation": "node scripts/verify-generation-foundation.mjs",
    "check:content-enrichment": "node scripts/verify-question-set-enrichment.mjs",
    "check:learning-evidence": "node scripts/verify-learning-evidence.mjs",
    "check:learning-reliability": "node scripts/verify-learning-reliability.mjs",
    "check:agent-runtime": "node scripts/verify-agent-runtime.mjs",
    "check:agent-loop": "node scripts/verify-agent-loop.mjs",
    "check:chat-context": "node scripts/verify-chat-context.mjs",
    "check:mastery-policy": "node scripts/verify-mastery-policy.mjs",
    "smoke:vue": "npm run web:build && npm run check:design && node scripts/smoke-vue-mobile.js",
    "test": "npm run smoke:ios"
  },
  "keywords": [
    "adaptive-tutoring",
    "ai-agent",
    "education-agent",
    "education-platform",
    "tutoring-agent",
    "learning-evidence",
    "agent-runtime",
    "local-first",
    "civil-service-exam",
    "capacitor",
    "vue"
  ],
  "author": "zhangl1001",
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/status-bar": "^8.0.2"
  },
  "description": "A local-first adaptive education Agent foundation with an end-to-end tutoring reference application.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangl1001/civil-ai.git"
  },
  "bugs": {
    "url": "https://github.com/zhangl1001/civil-ai/issues"
  },
  "homepage": "https://github.com/zhangl1001/civil-ai#readme",
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
