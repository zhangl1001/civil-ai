    {
      "id": "C",
      "content": {
        "schemaVersion": "content.v1",
        "blocks": [{ "id": "option-c", "type": "text", "source": "部分市民认为共享单车停放仍需规范。" }]
      }
    },
    {
      "id": "D",
      "content": {
        "schemaVersion": "content.v1",
        "blocks": [{ "id": "option-d", "type": "text", "source": "共享单车在周末的使用量高于工作日。" }]
      }
