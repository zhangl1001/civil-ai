{
  "name": "web-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "bash ../scripts/prepare-vue-public-assets.sh",
    "dev": "vite",
    "check:architecture": "node ../scripts/check-architecture.mjs",
    "check:metadata": "node ../scripts/verify-curriculum-fixtures.mjs",
    "check:content-schema": "node ../scripts/verify-content-schema.mjs",
    "check:content-metadata": "node ../scripts/verify-content-metadata.mjs",
    "check:prompt-compiler": "node ../scripts/verify-prompt-compiler.mjs",
    "check:provider-gateway": "node ../scripts/verify-provider-gateway.mjs",
    "check:generation-workflow": "node ../scripts/verify-generation-workflow.mjs",
    "check:generation-foundation": "node ../scripts/verify-generation-foundation.mjs",
    "check:learning-evidence": "node ../scripts/verify-learning-evidence.mjs",
    "check:agent-runtime": "node ../scripts/verify-agent-runtime.mjs",
    "check:chat-context": "node ../scripts/verify-chat-context.mjs",
    "check:mastery-policy": "node ../scripts/verify-mastery-policy.mjs",
    "typecheck": "vue-tsc",
    "build": "npm run check:architecture && npm run check:metadata && npm run check:content-metadata && npm run check:content-schema && npm run check:prompt-compiler && npm run check:provider-gateway && npm run check:generation-workflow && npm run check:generation-foundation && npm run check:learning-evidence && npm run check:agent-runtime && npm run check:chat-context && npm run check:mastery-policy && npm run typecheck && vite build",
    "build:with-legacy": "ZHANGL_VUE_BUNDLE_LEGACY=1 VITE_ENABLE_LEGACY_FALLBACK=1 npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "dompurify": "^3.4.12",
    "lucide-vue-next": "^0.378.0",
    "marked": "^18.0.6",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.6"
  }
}
